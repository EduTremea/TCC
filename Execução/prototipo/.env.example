# Conexao com o PostgreSQL (usado pelo docker-compose e pelo Python)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tcc
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Modelo de linguagem (Ollama local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Provedor de LLM: "ollama" (padrao) ou "openai"
LLM_PROVIDER=ollama

# Modelo pago (OpenAI) - preencher OPENAI_API_KEY apenas no .env local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
